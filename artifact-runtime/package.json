{
  "name": "slide2pptx-builder",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "JS builder that turns spec/detected.schema.json-compatible JSON into an editable PPTX.",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cli": "./src/convert.mjs"
  },
  "bin": {
    "slide2pptx-build": "./src/convert.mjs"
  },
  "scripts": {
    "build": "echo \"Use the CLI: node src/convert.mjs --spec <input.json> --out <output.pptx>\"",
    "test": "node test/run.mjs",
    "test:smoke": "node src/convert.mjs --self-test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
