{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.slide2pptx/schema/detected-v1.json",
  "title": "slide2pptx detected slide v1",
  "type": "object",
  "required": ["version", "source", "slide", "background", "elements"],
  "properties": {
    "version": { "const": "1.0" },
    "source": {
      "type": "object",
      "required": ["image_path", "width_px", "height_px"],
      "properties": {
        "image_path": { "type": "string" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "unit": { "const": "px" }
      },
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "required": ["strategy", "image_path"],
      "properties": {
        "strategy": { "enum": ["original", "cleaned", "solid"] },
        "image_path": { "type": ["string", "null"] },
        "fill": { "$ref": "#/$defs/color" }
      },
      "additionalProperties": true
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "metrics": { "type": "object", "additionalProperties": true },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "bbox": {
      "type": "object",
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": ["id", "kind", "bbox", "z", "editable_score", "render_strategy"],
      "properties": {
        "id": { "type": "string", "pattern": "^el_[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["text", "shape", "image"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "z": { "type": "integer" },
        "editable_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "render_strategy": { "enum": ["native", "image", "background"] },
        "rotation": { "type": "number" },
        "text": { "type": "string" },
        "font_family": { "type": "string" },
        "font_size": { "type": "number", "minimum": 1 },
        "font_weight": { "enum": ["normal", "bold"] },
        "font_style": { "enum": ["normal", "italic"] },
        "text_color": { "$ref": "#/$defs/color" },
        "align": { "enum": ["left", "center", "right"] },
        "valign": { "enum": ["top", "middle", "bottom"] },
        "geometry": { "enum": ["rect", "roundRect", "ellipse", "line"] },
        "fill": { "$ref": "#/$defs/color" },
        "line_color": { "$ref": "#/$defs/color" },
        "line_width": { "type": "number", "minimum": 0 },
        "image_path": { "type": "string" },
        "confidence": { "type": "object", "additionalProperties": { "type": "number" } },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "text" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "kind": { "const": "shape" } } },
          "then": { "required": ["geometry"] }
        },
        {
          "if": { "properties": { "kind": { "const": "image" } } },
          "then": { "required": ["image_path"] }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
